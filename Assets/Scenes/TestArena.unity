  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.97, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a1d0a9ac4e7f4c0b8f3a2b1c9d8e7f60, type: 3}
    m_FontSize: 48
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: 'E on the plate first, then the

    rune lock beside the door (the

    three
    symbols, 1-2-3) unlocks it.

    Through the door the grate at the

    far end
    of the hallway behind you

    bursts and three chase pufferfish

    come out:
    the dagger does nothing

    to them, three bites and you''re

    dead. Grab
    the two stone fragments

    (Space / Ctrl), slot them in the

    tablet by
    the far door, then take

    the trident at the end of the long

    corridor
    and the rubble seals it

    behind you.'
