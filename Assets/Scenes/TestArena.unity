    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: 'pedestal: the 3 stone fragments,

    then piece the tablet together on

    the
    board -> left door

    seaweed: 3 bone fragments -> bone

    key -> middle
    door

    rune lock: the three symbols in

    order (triangle, square, spiral)

    ->
    right door'
